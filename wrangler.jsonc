{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-paso-traffic-ticket-firm",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "LEAD_TO_EMAIL": "west@elpasotrafficticket.com",
    "LEAD_FROM_EMAIL": "El Paso Traffic Ticket Firm <leads@elpasotrafficticketfirm.com>"
  },
  "observability": { "enabled": true }
  // Secret to set in the dashboard or `npx wrangler secret put RESEND_API_KEY`
}
